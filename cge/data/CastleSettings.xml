<?xml version="1.0" encoding="utf-8"?>
<castle_settings>
  <!--
    usEncloseReferenceSize: scale the UI so the reference size always fits
    inside the actual window, preserving aspect ratio.
    Designed at 1280 x 800; will scale down on smaller screens.
  -->
  <ui_scaling
    mode="EncloseReferenceSize"
    reference_width="1280"
    reference_height="800"
  />

  <!--
    Default UI font family. Noto Sans ships with our data directory so it's
    available on every platform regardless of system fonts.
    OptimalSize = 20 at the reference UI size (scaled down on smaller screens).
  -->
  <default_font>
    <regular url="castle-data:/fonts/NotoSans-Regular.ttf"
             size="20"
             anti_aliased="true"/>
    <bold    url="castle-data:/fonts/NotoSans-Bold.ttf"
             size="20"
             anti_aliased="true"/>
  </default_font>
</castle_settings>
